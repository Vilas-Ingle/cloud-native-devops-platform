# AWS region for deployment
aws_region = "ap-south-1"

# VPC network range
vpc_cidr = "10.0.0.0/16"

# Prefix used to name AWS resources
project_name = "cloud-native-devops"

# Replace with your trusted public IP address in CIDR notation.
# Example only; do not use this documentation IP for deployment.
eks_public_access_cidrs = ["203.0.113.10/32"]
